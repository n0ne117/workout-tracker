# Workout Tracker configuration. Copy to .env and edit what you need.
# Every setting is optional — with no .env at all the defaults below apply.
# .env is gitignored.

# Host directory bind-mounted to /data. Holds workouts.db, which is the
# only thing here worth backing up.
# Relative paths resolve against this file's directory, NOT your shell's
# working directory. Use an absolute path if that is ever ambiguous.
WORKOUTS_DATA_HOST=./workout_data

# Port the web UI listens on, on the host.
WORKOUTS_PORT=7733

# Image tag to pull. `latest` follows releases; pin an explicit version
# (for example 1.1.0) if you would rather decide when to move.
WORKOUTS_IMAGE_TAG=latest

# Your timezone. Workouts are stored in local time, and GPX, TCX and KML
# files only carry UTC, so their start times are converted using this. FIT
# files and Intervals.icu bring their own offset. Also sets log timestamps.
TZ=UTC

# Run the API as this user instead of root, so files on the host are not
# left root-owned. Unraid uses 99 (nobody) and 100 (users). Leave both blank
# to run as root, which is the default and is fine for a single-user host.
# PUID=99
# PGID=100
